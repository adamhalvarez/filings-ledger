# Copy to .env.local for a local dev server. Real values go into Vercel's
# own environment variables for a deployed build, never into this repo.

# signal_store_reader's connection string, Supavisor session mode, port
# 5432. Read only: SELECT on schema signal_store, nothing on schema
# public. See record-scanner/money-signal-store/supabase/migrations/
# 20260903000010_reader_role.sql.
#
# Required. Every page queries the store at build time, so a dev server or
# a build without this fails at the first page rather than rendering an
# empty one. Type checking needs no database: npx tsc --noEmit.
SIGNAL_STORE_READER_URL=

# BASIC_AUTH_USER and BASIC_AUTH_PASS used to live here. The Basic Auth
# gate they fed was removed from middleware.ts at launch and nothing in
# this repo has read them since; they are gone from this file rather than
# left as two blanks a future reader would try to fill in.
